<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      DOLPHIN UI (AtiWpf.Ui) Theme
      PDF: ColorsDark + 컨트롤 Style 등록
      주의: AtiWpf.Ui는 Button TargetType 암시적 Style이 없으므로
            ButtonMedium / GroupBoxMedium 등을 StaticResource로 명시 적용해야 함
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Themes/ColorsDark.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Themes/Typography.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Themes/Icons.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Controls/Button/Button.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Controls/Button/ButtonGhost.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Controls/ToggleButton/ToggleButton.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Controls/GroupBox/GroupBox.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Controls/Menu/Menu.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Controls/Menu/MenuItem.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Controls/ScrollViewer/ScrollViewer.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Controls/ScrollBar/ScrollBar.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/AtiWpf.Ui;component/Controls/ProgressBar/ProgressBar.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- 암시적 Style: Dolphin named Style을 기본으로 연결 -->
    <Style TargetType="Button" BasedOn="{StaticResource ButtonMedium}"/>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonMedium}"/>
    <Style TargetType="GroupBox" BasedOn="{StaticResource GroupBoxMedium}"/>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    </Style>

    <!-- 좌측 패널용 컴팩트 컨트롤 -->
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource ButtonMedium}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Height" Value="28"/>
    </Style>

    <Style x:Key="CompactToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonMedium}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Height" Value="28"/>
    </Style>

    <Style x:Key="CompactGroupBox" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxMedium}">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Padding" Value="4,2,4,4"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="MatchGroupBox" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxMedium}">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Padding" Value="8,6,8,8"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="MatchButton" TargetType="Button" BasedOn="{StaticResource ButtonMedium}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <!-- 다크 ComboBox: ToggleButton 미사용(암시적 Style 충돌·글씨 안 보임 방지) -->
    <Style x:Key="DolphinComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="#2E3440"/>
        <Setter Property="Foreground" Value="#ECEFF4"/>
        <Setter Property="BorderBrush" Value="#4C566A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="#2E3440"/>
                    <Setter Property="Foreground" Value="#ECEFF4"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#5E81AC"/>
                                        <Setter Property="Foreground" Value="#ECEFF4"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#434C5E"/>
                                        <Setter Property="Foreground" Value="#ECEFF4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Style=null: Dolphin ToggleButton 암시적 Style이 덮어쓰지 않게 -->
                        <ToggleButton x:Name="DropToggle"
                                      Style="{x:Null}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="MainBorder"
                                Background="#2E3440"
                                BorderBrush="#4C566A"
                                BorderThickness="1"
                                CornerRadius="3"
                                MinHeight="34"
                                IsHitTestVisible="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="10,0,4,0"
                                           VerticalAlignment="Center"
                                           Foreground="#ECEFF4"
                                           FontSize="13"
                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Border Grid.Column="1" Background="#3B4252" CornerRadius="0,3,3,0">
                                    <Path Data="M0,0 L5,5 L10,0 Z" Fill="#ECEFF4"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Width="10" Height="6" Stretch="Fill"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Popup Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="#2E3440"
                                    BorderBrush="#4C566A"
                                    BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="#88C0D0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DolphinTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#2E3440"/>
        <Setter Property="Foreground" Value="#ECEFF4"/>
        <Setter Property="CaretBrush" Value="#ECEFF4"/>
        <Setter Property="SelectionBrush" Value="#5E81AC"/>
        <Setter Property="BorderBrush" Value="#4C566A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="#2E3440"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Foreground="#ECEFF4"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 탭 / 방식 선택 강조 -->
    <Style x:Key="MethodSelectButton" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonMedium}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="30"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#0A84FF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
