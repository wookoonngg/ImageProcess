<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WpfImageProcessing</RootNamespace>
    <AssemblyName>ImageProgram</AssemblyName>
    <!-- 네이티브 DLL(x64)과 맞춤 -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Resource\TestImages\**" />
    <EmbeddedResource Remove="Resource\TestImages\**" />
    <None Remove="Resource\TestImages\**" />
    <Page Remove="Resource\TestImages\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AtiWpf.Ui" Version="1.0.52" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <!-- C++ 빌드 산출물이 있으면 exe 옆으로 복사 (없어도 C# 빌드는 성공) -->
  <Target Name="CopyNativeDllIfExists" AfterTargets="Build">
    <ItemGroup>
      <_NativeDll Include="$(MSBuildThisFileDirectory)..\ImageProcessingNative\x64\$(Configuration)\ImageProcessingNative.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\ImageProcessingNative\x64\$(Configuration)\ImageProcessingNative.dll')" />
      <_NativeDll Include="$(MSBuildThisFileDirectory)bin\$(Configuration)\net8.0-windows\ImageProcessingNative.dll" Condition="Exists('$(MSBuildThisFileDirectory)bin\$(Configuration)\net8.0-windows\ImageProcessingNative.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_NativeDll)' != ''" />
  </Target>

</Project>
