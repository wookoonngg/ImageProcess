<Window x:Class="WpfImageProcessing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfImageProcessing.Controls"
        Title="WPF 반도체 검사 영상처리"
        Width="1500" Height="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">
    <DockPanel Margin="8">
        <Menu DockPanel.Dock="Top" Margin="0,0,0,6">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="BMP 열기(_O)..." Click="OpenMenuItem_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="BMP 저장(_S)..." Click="SaveMenuItem_Click" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="종료(_X)" Click="ExitMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,6"
                Background="{DynamicResource ContentBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                MinHeight="28">
            <DockPanel>
                <TextBlock x:Name="ProcessingTimeText" DockPanel.Dock="Right"
                           Text="Processing Time: - ms" FontWeight="Bold" FontSize="13"
                           Foreground="#1B6EF3" Margin="12,0,0,0"/>
                <TextBlock x:Name="ImageInfoText" DockPanel.Dock="Right"
                           Text="" Foreground="{DynamicResource AppForeground}" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusText" Text="① 원본 이미지를 열어 검사 시작"
                           Foreground="{DynamicResource AppForeground}" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="250" MinWidth="180"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="RightCol" Width="360" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- ①~⑦ 파이프라인 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ContentBackground}"
                    CornerRadius="4" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="검사 파이프라인" FontWeight="SemiBold" Margin="2,0,0,4"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <TextBlock Style="{StaticResource PanelHintText}"
                                   Text="위→아래 순서로 실행. 드래그 핸들로 패널 폭을 조절."/>

                        <GroupBox Header="① 원본 이미지 로드" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Content="이미지 열기 (BMP)" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="OpenMenuItem_Click"/>
                                <Button Content="결과 저장 (BMP)" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="SaveMenuItem_Click"/>
                                <ToggleButton x:Name="RoiSelectToggle" Content="관심영역(ROI) 선택"
                                              Style="{StaticResource ToggleButtonMedium}"
                                              HorizontalAlignment="Stretch" Margin="0,2"
                                              Click="RoiSelectToggle_Click"/>
                                <Button Content="ROI 취소" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="RoiCancel_Click"/>
                                <Button Content="연산 Reset (원본 복구)" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="ResetProcessing_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="② 노이즈 제거" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Content="가우시안 필터" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Gaussian"/>
                                <Button Content="평활화 (Smoothing)" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Smoothing"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="③ Edge(경계) 검출" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Content="Sobel" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Sobel"/>
                                <Button Content="Laplacian" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Laplacian"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="④ 이진화" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Content="Threshold (이진화)" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Threshold"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="⑤ 형태학적 처리" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Content="팽창 (Dilation)" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Dilation"/>
                                <Button Content="수축 (Erosion)" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Erosion"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ⑥+⑦ 통합: Template → 방식 선택 → 비교·판정 -->
                        <GroupBox Header="⑥⑦ 패턴 비교 · 판정" Style="{StaticResource GroupBoxMedium}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelHintText}" TextWrapping="Wrap"
                                           Text="올바른 검사 순서&#x0a;1) 골든(기준) 이미지 열기 → ROI → Template 등록&#x0a;2) 검사 대상 이미지를 새로 열기 (Template은 유지됨)&#x0a;3) 방식 선택 → 비교·판정 실행&#x0a;&#x0a;같은 이미지에서 등록·비교하면 그 자리에서 거의 만점이 나옵니다. Template은 다른 wafer/shot에 슬라이딩해야 검사입니다."/>
                                <Button Content="Template 등록 (골든 ROI)" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="TemplateRegister_Click"/>
                                <TextBlock x:Name="TemplateStatusText" Text="Template: 미등록"
                                           Margin="0,4,0,4" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppForeground}"/>

                                <StackPanel x:Name="MatchPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                    <TextBlock Text="비교 방식 (유사도 점수)" FontWeight="SemiBold" Margin="0,0,0,2"
                                               Foreground="{DynamicResource AppForeground}"/>
                                    <ToggleButton x:Name="MethodDiffBtn" Content="DIFF — 픽셀 차이(낮을수록 유사→점수화)"
                                                  Style="{StaticResource MethodSelectButton}"
                                                  Click="MethodSelect_Click" Tag="Diff"/>
                                    <ToggleButton x:Name="MethodCorrBtn" Content="CORR — 상관(높을수록 유사)"
                                                  Style="{StaticResource MethodSelectButton}"
                                                  Click="MethodSelect_Click" Tag="Corr"/>
                                    <ToggleButton x:Name="MethodCoeffBtn" Content="COEFF — 정규화 상관(권장, 0~1)"
                                                  Style="{StaticResource MethodSelectButton}"
                                                  Click="MethodSelect_Click" Tag="Coeff"/>

                                    <TextBlock Text="합격 기준 Score ≥" Margin="0,8,0,2"
                                               Foreground="{DynamicResource AppForeground}"/>
                                    <TextBox x:Name="PassThresholdBox" Text="0.80" Margin="0,0,0,4" Padding="4"/>

                                    <Button Content="비교 · 판정 실행" Style="{StaticResource ButtonMedium}"
                                            HorizontalAlignment="Stretch" Margin="0,2"
                                            Click="CompareAndJudge_Click"/>

                                    <TextBlock x:Name="MatchScoreText" Text="Score: -" Margin="0,8,0,0"
                                               Foreground="{DynamicResource AppForeground}"/>
                                    <TextBlock x:Name="MatchPositionText" Text="Position: -" Margin="0,2,0,0"
                                               Foreground="{DynamicResource AppForeground}"/>
                                    <TextBlock x:Name="JudgeResultText" Text="판정: -" Margin="0,6,0,0"
                                               FontWeight="Bold" Foreground="{DynamicResource AppForeground}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="#4C566A" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <GroupBox Grid.Column="2" Header="원본 Viewer"
                      Style="{StaticResource GroupBoxMedium}" Padding="4">
                <controls:ImageViewerControl x:Name="SourceViewer"/>
            </GroupBox>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          Background="#4C566A" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <GroupBox Grid.Column="4" Header="처리 결과 Viewer"
                      Style="{StaticResource GroupBoxMedium}" Padding="4">
                <controls:ImageViewerControl x:Name="ResultViewer"/>
            </GroupBox>

            <GridSplitter Grid.Column="5" Width="6" HorizontalAlignment="Stretch"
                          Background="#4C566A" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <!-- 우측: Navigator → Histogram → ROI → 분석 로그 (스플리터로 크기 조절) -->
            <Grid Grid.Column="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" MinHeight="120"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="0.9*" MinHeight="90"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto" MinHeight="56"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="1.1*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Navigator — 클릭 시 Viewer 이동" Style="{StaticResource GroupBoxMedium}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHintText}"
                                   Text="패널을 끌면 미리보기도 같이 커집니다.&#x0a;파란 박스 = 현재 Viewer 위치 · 클릭 → Viewer 이동"/>
                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                BorderBrush="#4C566A" BorderThickness="1"
                                Background="#1E1E1E" MinHeight="80" MinWidth="80">
                            <controls:NavigatorControl x:Name="Navigator"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"/>
                        </Border>
                    </DockPanel>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Background="#4C566A" ResizeDirection="Rows" ShowsPreview="True"/>

                <GroupBox Grid.Row="2" Header="Histogram (Gray 0→255)"
                          Style="{StaticResource GroupBoxMedium}">
                    <controls:HistogramControl x:Name="Histogram"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"/>
                </GroupBox>

                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch"
                              Background="#4C566A" ResizeDirection="Rows" ShowsPreview="True"/>

                <GroupBox Grid.Row="4" Header="ROI 정보" Style="{StaticResource GroupBoxMedium}">
                    <StackPanel Margin="6">
                        <TextBlock Style="{StaticResource PanelHintText}"
                                   Text="Viewer에서 ROI 드래그 → 연산은 ROI만 적용."/>
                        <TextBlock x:Name="RoiInfoText" Text="ROI: -"
                                   Foreground="{DynamicResource AppForeground}" FontWeight="SemiBold"/>
                    </StackPanel>
                </GroupBox>

                <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch"
                              Background="#4C566A" ResizeDirection="Rows" ShowsPreview="True"/>

                <GroupBox Grid.Row="6" Header="분석 로그" Style="{StaticResource GroupBoxMedium}">
                    <DockPanel Margin="4" LastChildFill="True">
                        <Button DockPanel.Dock="Top" Content="로그 지우기" Padding="6,2" Margin="0,0,0,4"
                                HorizontalAlignment="Right" Click="ClearAnalysisLog_Click"/>
                        <TextBox x:Name="AnalysisLogText"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Background="#1E1E1E"
                                 Foreground="#D8DEE9"
                                 BorderBrush="#4C566A"
                                 Text="이미지 열기 · ROI · 필터 · 패턴 비교 결과가 여기에 쌓입니다."/>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
