<Window x:Class="WpfImageProcessing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfImageProcessing.Controls"
        Title="WPF 반도체 검사 영상처리"
        Width="1560" Height="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">
    <DockPanel Margin="6">

        <!-- 상단 툴바 -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,4"
                Background="{DynamicResource ContentBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <Menu DockPanel.Dock="Left" Background="Transparent">
                    <MenuItem Header="File">
                        <MenuItem Header="Open BMP..." Click="OpenMenuItem_Click" InputGestureText="Ctrl+O"/>
                        <MenuItem Header="Save BMP..." Click="SaveMenuItem_Click" InputGestureText="Ctrl+S"/>
                        <Separator/>
                        <MenuItem Header="Reset Original" Click="ResetProcessing_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
                    </MenuItem>
                </Menu>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Open BMP" Style="{StaticResource ButtonMedium}"
                            Margin="0,0,6,0" Padding="12,4" Click="OpenMenuItem_Click"/>
                    <Button Content="Save BMP" Style="{StaticResource ButtonMedium}"
                            Margin="0,0,6,0" Padding="12,4" Click="SaveMenuItem_Click"/>
                    <Button Content="Reset Original" Style="{StaticResource ButtonMedium}"
                            Padding="12,4" Click="ResetProcessing_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 하단 상태바 -->
        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,6"
                Background="{DynamicResource ContentBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                MinHeight="28">
            <DockPanel>
                <TextBlock x:Name="ProcessingTimeText" DockPanel.Dock="Right"
                           Text="Processing Time: - ms" FontWeight="Bold" FontSize="13"
                           Foreground="#1B6EF3" Margin="16,0,0,0"/>
                <TextBlock x:Name="RoiInfoText" DockPanel.Dock="Right"
                           Text="ROI: -" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForeground}" Margin="16,0,0,0"/>
                <TextBlock x:Name="ImageInfoText" DockPanel.Dock="Right"
                           Text="" Foreground="{DynamicResource AppForeground}" Margin="16,0,0,0"/>
                <TextBlock x:Name="StatusText" Text="Open BMP로 원본 이미지를 여세요."
                           Foreground="{DynamicResource AppForeground}" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="320" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 Control Panel: 탭 버튼 + 선택 탭 내용 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ContentBackground}"
                    CornerRadius="4" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 탭 헤더 -->
                    <UniformGrid Rows="1" Columns="2" Margin="0,0,0,8">
                        <ToggleButton x:Name="TabPreprocessBtn" Content="탭1: 전처리"
                                      IsChecked="True" Margin="0,0,3,0"
                                      Style="{StaticResource MethodSelectButton}"
                                      Click="TabPreprocess_Click"/>
                        <ToggleButton x:Name="TabMatchingBtn" Content="탭2: 템플릿 매칭"
                                      IsChecked="False" Margin="3,0,0,0"
                                      Style="{StaticResource MethodSelectButton}"
                                      Click="TabMatching_Click"/>
                    </UniformGrid>

                    <!-- 선택된 탭 내용 -->
                    <Grid Grid.Row="1">
                        <!-- 탭1: 전처리 -->
                        <ScrollViewer x:Name="PanelPreprocess"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Visible">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelHintText}"
                                           Text="전처리 연산은 ROI에만 적용됩니다."/>

                                <GroupBox Header="ROI" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <ToggleButton x:Name="RoiSelectToggle" Content="ROI 선택"
                                                      Style="{StaticResource ToggleButtonMedium}"
                                                      HorizontalAlignment="Stretch" Margin="0,2"
                                                      Click="RoiSelectToggle_Click"/>
                                        <Button Content="ROI 취소" Style="{StaticResource ButtonMedium}"
                                                HorizontalAlignment="Stretch" Margin="0,2" Click="RoiCancel_Click"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="노이즈 제거" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Button Content="가우시안 필터" Style="{StaticResource ButtonMedium}"
                                                HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Gaussian"/>
                                        <Button Content="평활화 (Smoothing)" Style="{StaticResource ButtonMedium}"
                                                HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Smoothing"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Edge 검출" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Button Content="Sobel" Style="{StaticResource ButtonMedium}"
                                                HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Sobel"/>
                                        <Button Content="Laplacian" Style="{StaticResource ButtonMedium}"
                                                HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Laplacian"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="이진화" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                                    <Button Content="Threshold" Style="{StaticResource ButtonMedium}"
                                            HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Threshold"/>
                                </GroupBox>

                                <GroupBox Header="형태학" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Button Content="팽창 (Dilation)" Style="{StaticResource ButtonMedium}"
                                                HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Dilation"/>
                                        <Button Content="수축 (Erosion)" Style="{StaticResource ButtonMedium}"
                                                HorizontalAlignment="Stretch" Margin="0,2" Click="Process_Erosion"/>
                                    </StackPanel>
                                </GroupBox>

                                <Button Content="Reset Original" Style="{StaticResource ButtonMedium}"
                                        HorizontalAlignment="Stretch" Margin="0,2" Click="ResetProcessing_Click"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 탭2: 템플릿 매칭 -->
                        <ScrollViewer x:Name="PanelMatching"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,6"
                                           Text="템플릿 매칭 (Template Matching)"/>
                                <TextBlock Style="{StaticResource PanelHintText}"
                                           Text="1) 골든에서 Template 등록  2) 검사 이미지 Open  3) Matching 실행"/>

                                <!-- Step 1 -->
                                <GroupBox Header="Step 1. Template 준비" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Button Content="현재 ROI를 Template으로 등록"
                                                Style="{StaticResource ButtonMedium}"
                                                HorizontalAlignment="Stretch" Margin="0,2"
                                                Click="TemplateRegister_Click"/>
                                        <Button Content="Template 파일 불러오기 (.bmp)"
                                                Style="{StaticResource ButtonMedium}"
                                                HorizontalAlignment="Stretch" Margin="0,2"
                                                Click="TemplateLoadFromFile_Click"/>

                                        <TextBlock Text="Template Preview" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <Border Width="140" Height="140" HorizontalAlignment="Left"
                                                BorderBrush="#0A84FF" BorderThickness="2"
                                                Background="#1E1E1E" CornerRadius="2">
                                            <Grid>
                                                <TextBlock x:Name="TemplatePreviewPlaceholder"
                                                           Text="미등록" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Opacity="0.55"/>
                                                <Image x:Name="TemplatePreviewImage"
                                                       Stretch="Uniform" Margin="4"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="TemplateStatusText" Text="Template: 미등록"
                                                   Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Step 2 -->
                                <GroupBox Header="Step 2. 검색 범위 지정" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <RadioButton x:Name="SearchFullRadio" GroupName="SearchScope"
                                                     Content="이미지 전체 검색" IsChecked="True"
                                                     Margin="0,6" FontSize="13"
                                                     Foreground="{DynamicResource AppForeground}"/>
                                        <RadioButton x:Name="SearchRoiRadio" GroupName="SearchScope"
                                                     Content="ROI 영역 내 검색"
                                                     Margin="0,6" FontSize="13"
                                                     Foreground="{DynamicResource AppForeground}"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Step 3 -->
                                <GroupBox Header="Step 3. 알고리즘 및 실행" Style="{StaticResource GroupBoxMedium}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="알고리즘" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="MatchMethodCombo" Margin="0,0,0,10"
                                                  SelectedIndex="2" Height="28"
                                                  SelectionChanged="MatchMethodCombo_SelectionChanged">
                                            <ComboBoxItem Content="DIFF (SAD)" Tag="Diff"/>
                                            <ComboBoxItem Content="CORR" Tag="Corr"/>
                                            <ComboBoxItem Content="COEFF (NCC)" Tag="Coeff"/>
                                        </ComboBox>

                                        <TextBlock Text="합격 기준 Score ≥" Margin="0,0,0,2"/>
                                        <TextBox x:Name="PassThresholdBox" Text="0.80"
                                                 Margin="0,0,0,10" Padding="4" Height="28"/>

                                        <Button Content="Template Matching 실행"
                                                Style="{StaticResource ButtonMedium}"
                                                HorizontalAlignment="Stretch" Margin="0,2" Height="36"
                                                FontWeight="Bold"
                                                Click="CompareAndJudge_Click"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- 결과 -->
                                <GroupBox Header="결과 (Viewer 2에 Box 표시)" Style="{StaticResource GroupBoxMedium}">
                                    <StackPanel>
                                        <TextBlock x:Name="MatchScoreText" Text="Score: -"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,4"/>
                                        <TextBlock x:Name="MatchPositionText" Text="Position: -"
                                                   FontSize="13" Margin="0,2"/>
                                        <TextBlock x:Name="JudgeResultText" Text="판정: -"
                                                   FontSize="14" FontWeight="Bold" Margin="0,8,0,4"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="#4C566A" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <GroupBox Grid.Column="2" Header="Image Viewer 1 — 원본"
                      Style="{StaticResource GroupBoxMedium}" Padding="4">
                <controls:ImageViewerControl x:Name="SourceViewer"/>
            </GroupBox>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          Background="#4C566A" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <GroupBox Grid.Column="4" Header="Image Viewer 2 — 결과"
                      Style="{StaticResource GroupBoxMedium}" Padding="4">
                <controls:ImageViewerControl x:Name="ResultViewer"/>
            </GroupBox>

            <GridSplitter Grid.Column="5" Width="6" HorizontalAlignment="Stretch"
                          Background="#4C566A" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <!-- 우측 Sub Panel -->
            <Grid Grid.Column="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*" MinHeight="120"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="0.9*" MinHeight="100"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="1.2*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Navigator (미니맵)" Style="{StaticResource GroupBoxMedium}">
                    <Border BorderBrush="#4C566A" BorderThickness="1" Background="#1E1E1E">
                        <controls:NavigatorControl x:Name="Navigator"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"/>
                    </Border>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Background="#4C566A" ResizeDirection="Rows" ShowsPreview="True"/>

                <GroupBox Grid.Row="2" Header="Histogram" Style="{StaticResource GroupBoxMedium}">
                    <controls:HistogramControl x:Name="Histogram"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"/>
                </GroupBox>

                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch"
                              Background="#4C566A" ResizeDirection="Rows" ShowsPreview="True"/>

                <GroupBox Grid.Row="4" Header="Log / Info" Style="{StaticResource GroupBoxMedium}">
                    <DockPanel Margin="4" LastChildFill="True">
                        <Button DockPanel.Dock="Top" Content="로그 지우기" Padding="6,2" Margin="0,0,0,4"
                                HorizontalAlignment="Right" Click="ClearAnalysisLog_Click"/>
                        <TextBox x:Name="AnalysisLogText"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Background="#1E1E1E"
                                 Foreground="#D8DEE9"
                                 BorderBrush="#4C566A"
                                 Text="Open · ROI · 전처리 · Template Matching 로그"/>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
