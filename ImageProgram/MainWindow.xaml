<Window x:Class="WpfImageProcessing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfImageProcessing.Controls"
        Title="WPF 반도체 검사 영상처리"
        Width="1560" Height="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">
    <DockPanel Margin="6">

        <!-- 상단 툴바 -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,4" Padding="6,3"
                Background="{DynamicResource ContentBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <Menu DockPanel.Dock="Left" Background="Transparent">
                    <MenuItem Header="File">
                        <MenuItem Header="Open BMP..." Click="OpenMenuItem_Click" InputGestureText="Ctrl+O"/>
                        <MenuItem Header="Save BMP..." Click="SaveMenuItem_Click" InputGestureText="Ctrl+S"/>
                        <Separator/>
                        <MenuItem Header="Reset Original" Click="ResetProcessing_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
                    </MenuItem>
                </Menu>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Open BMP" Style="{StaticResource CompactButton}"
                            Width="100" Margin="0,0,6,0" Click="OpenMenuItem_Click"/>
                    <Button Content="Save BMP" Style="{StaticResource CompactButton}"
                            Width="100" Margin="0,0,6,0" Click="SaveMenuItem_Click"/>
                    <Button Content="Reset Original" Style="{StaticResource CompactButton}"
                            Width="120" Click="ResetProcessing_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 하단 상태바 -->
        <Border DockPanel.Dock="Bottom" Margin="0,4,0,0" Padding="8,4"
                Background="{DynamicResource ContentBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                MinHeight="26">
            <DockPanel>
                <TextBlock x:Name="ProcessingTimeText" DockPanel.Dock="Right"
                           Text="Processing Time: - ms" FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource AppForeground}" Margin="16,0,0,0"/>
                <TextBlock x:Name="RoiInfoText" DockPanel.Dock="Right"
                           Text="ROI: -" FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource AppForeground}" Margin="16,0,0,0"/>
                <TextBlock x:Name="ImageInfoText" DockPanel.Dock="Right"
                           Text="" FontSize="12"
                           Foreground="{DynamicResource AppForeground}" Margin="16,0,0,0"/>
                <TextBlock x:Name="StatusText" Text="Open BMP로 원본 이미지를 여세요." FontSize="12"
                           Foreground="{DynamicResource AppForeground}" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 Control Panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ContentBackground}"
                    CornerRadius="4" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Rows="1" Columns="2" Margin="0,0,0,4">
                        <ToggleButton x:Name="TabPreprocessBtn" Content="전처리"
                                      IsChecked="True" Margin="0,0,2,0"
                                      Style="{StaticResource MethodSelectButton}"
                                      Click="TabPreprocess_Click"/>
                        <ToggleButton x:Name="TabMatchingBtn" Content="템플릿매칭"
                                      IsChecked="False" Margin="2,0,0,0"
                                      Style="{StaticResource MethodSelectButton}"
                                      Click="TabMatching_Click"/>
                    </UniformGrid>

                    <Grid Grid.Row="1">
                        <!-- 전처리: 한 화면에 맞춤 -->
                        <StackPanel x:Name="PanelPreprocess" Visibility="Visible">
                            <GroupBox Header="ROI" Style="{StaticResource CompactGroupBox}">
                                <StackPanel>
                                    <ToggleButton x:Name="RoiSelectToggle" Content="ROI 선택"
                                                  Style="{StaticResource CompactToggle}"
                                                  Click="RoiSelectToggle_Click"/>
                                    <Button Content="ROI 취소" Style="{StaticResource CompactButton}"
                                            Click="RoiCancel_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="노이즈 제거" Style="{StaticResource CompactGroupBox}">
                                <StackPanel>
                                    <Button Content="가우시안 필터" Style="{StaticResource CompactButton}"
                                            Click="Process_Gaussian"/>
                                    <Button Content="평활화 (Smoothing)" Style="{StaticResource CompactButton}"
                                            Click="Process_Smoothing"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Edge 검출" Style="{StaticResource CompactGroupBox}">
                                <StackPanel>
                                    <Button Content="Sobel" Style="{StaticResource CompactButton}"
                                            Click="Process_Sobel"/>
                                    <Button Content="Laplacian" Style="{StaticResource CompactButton}"
                                            Click="Process_Laplacian"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="이진화" Style="{StaticResource CompactGroupBox}">
                                <Button Content="Threshold" Style="{StaticResource CompactButton}"
                                        Click="Process_Threshold"/>
                            </GroupBox>

                            <GroupBox Header="형태학" Style="{StaticResource CompactGroupBox}">
                                <StackPanel>
                                    <Button Content="팽창 (Dilation)" Style="{StaticResource CompactButton}"
                                            Click="Process_Dilation"/>
                                    <Button Content="수축 (Erosion)" Style="{StaticResource CompactButton}"
                                            Click="Process_Erosion"/>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="Reset Original" Style="{StaticResource CompactButton}"
                                    Click="ResetProcessing_Click"/>
                        </StackPanel>

                        <!-- 템플릿매칭: 여유 있게 + 스크롤 허용 -->
                        <ScrollViewer x:Name="PanelMatching"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed"
                                      Padding="2,0,4,4">
                            <StackPanel>
                                <GroupBox Header="Step 1. Template 준비" Style="{StaticResource MatchGroupBox}">
                                    <StackPanel>
                                        <Button Content="현재 ROI를 Template으로 등록"
                                                Style="{StaticResource MatchButton}"
                                                Click="TemplateRegister_Click"/>
                                        <Button Content="Template 파일 불러오기 (.bmp)"
                                                Style="{StaticResource MatchButton}"
                                                Click="TemplateLoadFromFile_Click"/>

                                        <TextBlock Text="Template Preview" FontWeight="SemiBold"
                                                   FontSize="12" Margin="0,12,0,8"
                                                   HorizontalAlignment="Center"/>
                                        <Border Width="120" Height="120"
                                                HorizontalAlignment="Center"
                                                BorderBrush="#4C566A" BorderThickness="1"
                                                Background="#1E1E1E">
                                            <Grid>
                                                <TextBlock x:Name="TemplatePreviewPlaceholder"
                                                           Text="미등록" FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Opacity="0.5"/>
                                                <Image x:Name="TemplatePreviewImage"
                                                       Stretch="Uniform" Margin="4"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="TemplateStatusText" Text="Template: 미등록"
                                                   Margin="0,8,0,4" FontSize="11" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Step 2. 검색 범위" Style="{StaticResource MatchGroupBox}">
                                    <StackPanel>
                                        <RadioButton x:Name="SearchFullRadio" GroupName="SearchScope"
                                                     Content="이미지 전체 검색" IsChecked="True"
                                                     Margin="0,6" FontSize="13"
                                                     Foreground="{DynamicResource AppForeground}"/>
                                        <RadioButton x:Name="SearchRoiRadio" GroupName="SearchScope"
                                                     Content="ROI 영역 내 검색"
                                                     Margin="0,6" FontSize="13"
                                                     Foreground="{DynamicResource AppForeground}"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Step 3. 알고리즘 및 실행" Style="{StaticResource MatchGroupBox}">
                                    <StackPanel>
                                        <TextBlock Text="알고리즘" FontSize="12" Margin="0,2,0,6"
                                                   Foreground="#ECEFF4"/>
                                        <ComboBox x:Name="MatchMethodCombo"
                                                  Style="{StaticResource DolphinComboBox}"
                                                  SelectedIndex="2" Margin="0,0,0,12"
                                                  SelectionChanged="MatchMethodCombo_SelectionChanged">
                                            <ComboBoxItem Content="DIFF (SAD)" Tag="Diff"/>
                                            <ComboBoxItem Content="CORR" Tag="Corr"/>
                                            <ComboBoxItem Content="COEFF (NCC)" Tag="Coeff"/>
                                        </ComboBox>

                                        <TextBlock Text="합격 기준 Score ≥" FontSize="12" Margin="0,0,0,6"
                                                   Foreground="#ECEFF4"/>
                                        <TextBox x:Name="PassThresholdBox" Text="0.80"
                                                 Style="{StaticResource DolphinTextBox}"
                                                 Margin="0,0,0,12"/>

                                        <Button Content="Template Matching 실행"
                                                Style="{StaticResource MatchButton}"
                                                FontWeight="SemiBold"
                                                Click="CompareAndJudge_Click"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="결과" Style="{StaticResource MatchGroupBox}">
                                    <StackPanel>
                                        <TextBlock x:Name="MatchScoreText" Text="Score: -"
                                                   FontSize="13" FontWeight="SemiBold" Margin="0,4"/>
                                        <TextBlock x:Name="MatchPositionText" Text="Position: -"
                                                   FontSize="12" Margin="0,4"/>
                                        <TextBlock x:Name="JudgeResultText" Text="판정: -"
                                                   FontSize="13" FontWeight="Bold" Margin="0,6,0,2"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#4C566A" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <GroupBox Grid.Column="2" Header="Image Viewer 1 — 원본"
                      Style="{StaticResource CompactGroupBox}" Padding="2">
                <controls:ImageViewerControl x:Name="SourceViewer"/>
            </GroupBox>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="#4C566A" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <GroupBox Grid.Column="4" Header="Image Viewer 2 — 결과"
                      Style="{StaticResource CompactGroupBox}" Padding="2">
                <controls:ImageViewerControl x:Name="ResultViewer"/>
            </GroupBox>

            <GridSplitter Grid.Column="5" Width="5" HorizontalAlignment="Stretch"
                          Background="#4C566A" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <Grid Grid.Column="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*" MinHeight="100"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="0.9*" MinHeight="90"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="1.2*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Navigator" Style="{StaticResource CompactGroupBox}">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Background="{DynamicResource AppBackground}">
                        <controls:NavigatorControl x:Name="Navigator"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"/>
                    </Border>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              Background="#4C566A" ResizeDirection="Rows" ShowsPreview="True"/>

                <GroupBox Grid.Row="2" Header="Histogram" Style="{StaticResource CompactGroupBox}">
                    <controls:HistogramControl x:Name="Histogram"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"/>
                </GroupBox>

                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                              Background="#4C566A" ResizeDirection="Rows" ShowsPreview="True"/>

                <GroupBox Grid.Row="4" Header="Log / Info" Style="{StaticResource CompactGroupBox}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Top" Content="로그 지우기"
                                Style="{StaticResource CompactButton}"
                                HorizontalAlignment="Right" Width="90" Margin="0,0,0,2"
                                Click="ClearAnalysisLog_Click"/>
                        <TextBox x:Name="AnalysisLogText"
                                 Style="{StaticResource DolphinTextBox}"
                                 Height="Auto"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Text=""/>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
