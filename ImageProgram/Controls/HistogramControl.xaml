<UserControl x:Class="WpfImageProcessing.Controls.HistogramControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" MinHeight="120">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Histogram Viewer" Foreground="#88C0D0" FontWeight="SemiBold"/>
        <Border Grid.Row="1" BorderBrush="#4C566A" BorderThickness="1" Margin="0,4,0,0">
            <Canvas x:Name="HistogramCanvas" ClipToBounds="True" Background="#2E3440"/>
        </Border>
    </Grid>
</UserControl>
