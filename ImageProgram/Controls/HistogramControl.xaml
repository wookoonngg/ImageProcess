<UserControl x:Class="WpfImageProcessing.Controls.HistogramControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" MinHeight="90">
    <!-- 가로로 긴 히스토그램: 좌우로 넓고 높이는 낮게 -->
    <Grid Margin="4,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="60"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock x:Name="PeakLabel" DockPanel.Dock="Right" FontSize="11" Foreground="#EBCB8B"/>
            <TextBlock Text="← 0　　밝기　　255 →"
                       FontSize="11" Foreground="#88C0D0" HorizontalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#4C566A" BorderThickness="1" Margin="0,2,0,0"
                Background="#2E3440" MinHeight="70">
            <Canvas x:Name="HistogramCanvas" ClipToBounds="True"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="0" FontSize="10" Foreground="#D8DEE9"/>
            <TextBlock Grid.Column="1" Text="128" FontSize="10" Foreground="#D8DEE9" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="255" FontSize="10" Foreground="#D8DEE9" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
