<UserControl x:Class="WpfImageProcessing.Controls.NavigatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2E3440">
    <Border BorderBrush="#4C566A" BorderThickness="1" Background="#1E1E1E">
        <Canvas x:Name="PreviewCanvas"
                ClipToBounds="True"
                Cursor="Hand"
                ToolTip="이미지 영역 클릭 → 원본 Viewer 이동 (여백 클릭은 무시)"
                SizeChanged="PreviewCanvas_SizeChanged">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
            <Rectangle x:Name="ViewportRect"
                       Stroke="#88C0D0" StrokeThickness="1.5"
                       Fill="#3388C0D0"
                       Visibility="Collapsed"/>
        </Canvas>
    </Border>
</UserControl>
