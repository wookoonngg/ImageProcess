<UserControl x:Class="WpfImageProcessing.Controls.NavigatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2E3440">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Navigator" Foreground="#88C0D0" FontWeight="SemiBold" Margin="0,0,0,4"/>

        <Border Grid.Row="1"
                BorderBrush="#4C566A" BorderThickness="1"
                Background="#1E1E1E">
            <Canvas x:Name="PreviewCanvas"
                    ClipToBounds="True"
                    SizeChanged="PreviewCanvas_SizeChanged">
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                <Rectangle x:Name="ViewportRect"
                           Stroke="#88C0D0" StrokeThickness="1.5"
                           Fill="#3388C0D0"
                           Visibility="Collapsed"/>
            </Canvas>
        </Border>
    </Grid>
</UserControl>
